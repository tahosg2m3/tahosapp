# Application
PORT=3001
PEER_PORT=9000
HOST=127.0.0.1
PEER_HOST=127.0.0.1
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Total upload storage is limited to 5 GiB by default.
# UPLOAD_STORAGE_LIMIT_BYTES=5368709120

# Set JWT_SECRET in production. When APP_DATA_DIR is set in the Electron package,
# the app generates a persistent secure key in the user data directory instead.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Application data is encrypted with AES-256-GCM. This variable is optional:
# when empty in development, backend/data.sqlite-key is generated securely at random.
# For server/host deployments, provide a 32-byte value as 64 hex, base64, or base64url.
# Existing data cannot be decrypted if this key is lost; never commit it to Git.
# DATA_ENCRYPTION_KEY=replace-with-64-hex-characters

# SMTP (SMTP_SECURE defaults to true for port 465.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
MAIL_FROM="tahosapp <your-email@example.com>"

# GIF search (create a key at https://developers.giphy.com/.)
GIPHY_API_KEY=your-giphy-api-key

# Spotify Web API (create an app at https://developer.spotify.com/dashboard)
# The redirect URI must exactly match the URI allowlisted in the Spotify app.
# SPOTIFY_CLIENT_ID=your-spotify-client-id
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# SPOTIFY_REDIRECT_URI=https://api.example.com/api/spotify/callback

# WebRTC TURN (use the same value as coturn static-auth-secret on server deployments).
# TURN_SECRET must be a random secret of at least 32 characters and is never sent to clients.
# TURN_HOST=turn.example.com
# TURN_PORT=3478
# TURN_CREDENTIAL_TTL_SECONDS=600
# TURN_SECRET=replace-with-a-long-random-secret
# TURN_TLS_PORT=5349

# Optional: keep secrets in an external file for packaged installations.
# RUNTIME_ENV_FILE=C:\path\to\runtime.env

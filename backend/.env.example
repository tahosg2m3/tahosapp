# Uygulama
PORT=3001
PEER_PORT=9000
HOST=127.0.0.1
PEER_HOST=127.0.0.1
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Toplam yükleme alanı varsayılan olarak 5 GiB ile sınırlandırılır.
# UPLOAD_STORAGE_LIMIT_BYTES=5368709120

# Production'da JWT_SECRET verin. Electron paketinde APP_DATA_DIR ayarlanırsa
# uygulama bunun yerine kullanıcı veri klasöründe kalıcı güvenli bir anahtar üretir.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Uygulama verisi AES-256-GCM ile şifrelenir. Bu değişken isteğe bağlıdır:
# boşsa geliştirmede backend/data.sqlite-key güvenli ve rastgele oluşturulur.
# Sunucu/host dağıtımında 32 baytlık değeri 64 hex, base64 veya base64url verin.
# Bu anahtarı kaybederseniz mevcut veriler çözülemez; Git'e göndermeyin.
# DATA_ENCRYPTION_KEY=replace-with-64-hex-characters

# SMTP (465 portu için SMTP_SECURE belirtilmezse true varsayılır.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
MAIL_FROM="tahosapp <your-email@example.com>"

# GIF araması (https://developers.giphy.com/ üzerinden anahtar oluşturun.)
GIPHY_API_KEY=your-giphy-api-key

# WebRTC TURN (sunucu dağıtımında coturn static-auth-secret ile aynı değer).
# TURN_SECRET en az 32 karakterlik rastgele bir sır olmalıdır; istemciye gönderilmez.
# TURN_HOST=turn.example.com
# TURN_PORT=3478
# TURN_CREDENTIAL_TTL_SECONDS=600
# TURN_SECRET=replace-with-a-long-random-secret
# TURN_TLS_PORT=5349

# İsteğe bağlı: paketli kurulumda sırları harici dosyada tutmak için.
# RUNTIME_ENV_FILE=C:\path\to\runtime.env

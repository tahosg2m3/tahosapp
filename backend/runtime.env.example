# Paketli Electron uygulaması için SMTP ayarları.
# Bu dosya ilk açılışta uygulama veri klasörüne `runtime.env.example` olarak
# kopyalanır. Dosyayı `runtime.env` adıyla çoğaltıp gerçek değerleri girin.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
MAIL_FROM="tahosapp <your-email@example.com>"
GIPHY_API_KEY=your-giphy-api-key

# Platform genelindeki kullanıcı yönetimine erişebilecek hesapların kayıtlı
# e-posta adresleri. Birden çok adresi virgülle ayırın.
PLATFORM_ADMIN_EMAILS=your-account@example.com
# E-posta değişse bile erişimin korunması gerekiyorsa kullanıcı kimliği eklenebilir.
# PLATFORM_ADMIN_USER_IDS=uuid-1,uuid-2

# Toplam yükleme alanı varsayılan olarak 5 GiB ile sınırlandırılır.
# UPLOAD_STORAGE_LIMIT_BYTES=5368709120

# Uzak sunucu modunda isteğe bağlı WebRTC TURN ayarları.
# TURN_HOST=turn.example.com
# TURN_PORT=3478
# TURN_CREDENTIAL_TTL_SECONDS=600
# TURN_SECRET=replace-with-a-long-random-secret
# TURN_TLS_PORT=5349

# Paketli Electron bu anahtarı Windows DPAPI/macOS Keychain ile otomatik korur.
# Harici backend çalıştırıyorsanız isteğe bağlı 32 baytlık anahtar tanımlayabilirsiniz.
# DATA_ENCRYPTION_KEY=replace-with-64-hex-characters

# SMTP settings for the packaged Electron application.
# On first launch, this file is copied to the application data directory as
# `runtime.env.example`. Duplicate it as `runtime.env` and enter real values.

# Brevo SMTP: copy Login and an SMTP key from Settings > SMTP & API > SMTP.
# Use an SMTP key, not your account password or an API key.
# Port 587 requires STARTTLS; SMTP_SECURE=false enables this upgrade.
# MAIL_FROM must use a sender address verified in Brevo, separate from SMTP_USER.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM="tahosapp <verified-sender@example.com>"
GIPHY_API_KEY=your-giphy-api-key

# Registered email addresses for accounts that can access platform-wide user
# management. Separate multiple addresses with commas.
PLATFORM_ADMIN_EMAILS=your-account@example.com
# Add user IDs when access must be retained even if an email address changes.
# PLATFORM_ADMIN_USER_IDS=uuid-1,uuid-2

# Total upload storage is limited to 5 GiB by default.
# UPLOAD_STORAGE_LIMIT_BYTES=5368709120

# Optional WebRTC TURN settings for remote server mode.
# TURN_HOST=turn.example.com
# TURN_PORT=3478
# TURN_CREDENTIAL_TTL_SECONDS=600
# TURN_SECRET=replace-with-a-long-random-secret
# TURN_TLS_PORT=5349

# Packaged Electron automatically protects this key with Windows DPAPI/macOS Keychain.
# When running an external backend, you may set an optional 32-byte key.
# DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
# Spotify Web API (optional listening invites)
# SPOTIFY_CLIENT_ID=your-spotify-client-id
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# SPOTIFY_REDIRECT_URI=https://api.example.com/api/spotify/callback

# Passkey/WebAuthn settings. Production defaults are derived from the web
# application's HTTPS Origin; set these explicitly when API and web hosts differ.
# WEBAUTHN_ORIGIN=https://tahosapp.com.tr
# WEBAUTHN_RP_ID=tahosapp.com.tr
# WEBAUTHN_RP_NAME=tahosapp

# Web Push keys are generated once and kept in encrypted application storage.
# Define fixed keys only when several backend instances share subscriptions.
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# AUTH_SESSION_DAYS=7

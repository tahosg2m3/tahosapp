{
  "name": "tahosapp",
  "version": "1.1.6",
  "description": "Tahosapp desktop communication application",
  "author": "tahosg2m3",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:frontend": "cd frontend && npm run build",
    "build:frontend:desktop": "cd frontend && cross-env VITE_BASE_PATH=/ npm run build",
    "build:electron": "electron-builder",
    "build": "npm run build:frontend:desktop && npm run build:electron",
    "deploy:production": "powershell -NoProfile -ExecutionPolicy Bypass -File deployment/deploy.ps1",
    "publish:production": "powershell -NoProfile -ExecutionPolicy Bypass -File deployment/publish.ps1",
    "release:production": "npm run build && npm run publish:production",
    "smtp:production": "powershell -NoProfile -ExecutionPolicy Bypass -File deployment/update-smtp.ps1",
    "postinstall": "cd backend && npm install && cd ../frontend && npm install"
  },
  "build": {
    "appId": "com.tahosapp.desktop",
    "productName": "tahosapp",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "deployment/app-config.json",
      "frontend/dist/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://tahosapp.com.tr/updates/windows/",
        "channel": "latest"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "installer/tahosapp.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "tahosapp",
      "runAfterFinish": true,
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "license": "installer/license_tr.txt",
      "include": "installer/installer.nsh",
      "installerIcon": "installer/tahosapp.ico",
      "uninstallerIcon": "installer/tahosapp.ico",
      "artifactName": "tahosapp-Setup-${version}.${ext}",
      "uninstallDisplayName": "tahosapp ${version}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "darkModeSupport": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": {
        "LSMultipleInstancesProhibited": true,
        "NSMicrophoneUsageDescription": "tahosapp sesli sohbet için mikrofonunu kullanır.",
        "NSCameraUsageDescription": "tahosapp görüntülü sohbet için kameranı kullanır.",
        "NSAudioCaptureUsageDescription": "tahosapp ekran yayını sırasında sistem sesini paylaşmak için ses yakalama izni kullanır."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
